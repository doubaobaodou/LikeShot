<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- 不能开隐式 using：它会全局带进 System.Drawing / System.Windows.Forms，
         和 WPF 的 Point、Color、Application 全部撞名。 -->
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LikeShot</AssemblyName>
    <RootNamespace>LikeShot</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.5</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>LikeShot 截图</Product>
    <AssemblyTitle>LikeShot 截图</AssemblyTitle>
    <Description>和 QQ 同款操作习惯的截图工具，热键与 QQ 共存并自动避让</Description>
    <Copyright>Copyright © 2026 doubaobaodou</Copyright>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
